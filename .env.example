PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173

# --- MongoDB -------------------------------------------------------------
# Atlas: Database -> Connect -> Drivers. Paste that string here and substitute
# your password. The database is created automatically on first write.
# A local server works too: mongodb://127.0.0.1:27017
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=fintrack

# Only if 'mongodb+srv' lookups fail with querySrv ECONNREFUSED, which means Node
# read an unreachable resolver from the system. Overrides DNS for this process.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# --- Which provider the assistant uses: gemini | anthropic ---------------
AI_PROVIDER=gemini

# Google Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-3.1-flash-lite = 15 req/min. gemini-3.7-flash is sharper but capped at
# 20 requests per DAY on the free tier.
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Anthropic Claude ----------------------------------------------------
# Paid, and billed separately from a Claude Pro subscription.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
